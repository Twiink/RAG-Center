# 运行环境标识；local 开发时可开更多调试日志
RAG_APP_ENV=local

# PostgreSQL 连接串，需已安装 pgvector 扩展
RAG_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_center

# Embedding 模型：文档切块与检索时把文本转成向量。须与 EMBEDDING_DIMENSIONS 一致，换模型后需全量 reindex
RAG_MODEL_BASE_URL=https://api.openai.com/v1
RAG_MODEL_API_KEY=your-api-key
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=10

# LLM：用于 query 改写等可选能力，与 Embedding 可指向不同厂商
RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_API_KEY=your-deepseek-api-key
RAG_LLM_MODEL=deepseek-v4-flash
RAG_LLM_STRONG_MODEL=deepseek-v4-pro
RAG_LLM_TIMEOUT_SECONDS=60

# 向量与关键词双存储：pgvector 做语义检索，Elasticsearch 做 BM25（hybrid/bm25 模式依赖 ES）
RAG_VECTOR_STORE=pgvector
RAG_KEYWORD_SEARCH_PROVIDER=elasticsearch
RAG_ELASTICSEARCH_URL=http://localhost:9200
RAG_ELASTICSEARCH_INDEX=rag_chunks
RAG_ELASTICSEARCH_TIMEOUT_SECONDS=30
RAG_EXTERNAL_HTTP_MAX_CONNECTIONS=100
RAG_EXTERNAL_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
RAG_EXTERNAL_HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# 检索模式与候选宽度：hybrid 固定使用全局 RRF（rrf_k=60）
RAG_RETRIEVAL_MODE=vector
RAG_HYBRID_VECTOR_TOP_K=20
RAG_HYBRID_BM25_TOP_K=20

# 文档切块与 retrieve 默认参数：结构化切块的最大块长、重叠、表格分组行数等
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TABLE_MAX_ROWS_PER_CHUNK=10
RAG_TOP_K=5
RAG_MULTI_KB_MAX=5
RAG_QUERY_MAX_LENGTH=2000

# 专用精排：API Key 留空时复用 MODEL_API_KEY
RAG_RERANK_ENABLED=false
RAG_RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3-rerank
# 高级配置，一般不需要调整
RAG_RERANK_TIMEOUT_SECONDS=15

# 证据编排：复用 LLM，从已有候选组织可追溯证据包，默认关闭
RAG_EVIDENCE_ENABLED=false
RAG_EVIDENCE_TIMEOUT_SECONDS=15

# Query 改写：用 LLM 把口语化问题改写成更利于检索的表述，默认关闭
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_TIMEOUT_MS=2000

# 日志：按天滚动，error.log 单独收 ERROR 便于排查
RAG_LOG_LEVEL=INFO
RAG_LOG_DIR=logs
RAG_LOG_MAX_BYTES=20971520
RAG_LOG_BACKUP_COUNT=5
RAG_LOG_ERROR_MAX_BYTES=20971520
RAG_LOG_ERROR_BACKUP_COUNT=10
RAG_LOG_DAILY_BACKUP_COUNT=14
RAG_LOG_BODY_MAX_CHARS=4000
RAG_LOG_LLM_MAX_CHARS=8000
RAG_LOG_REQUEST_BODY=false
RAG_LOG_RESPONSE_BODY=false

# API Key 鉴权：local 调试可设 false，自动使用 tenant_demo
RAG_AUTH_ENABLED=true

# Celery 异步索引：upload 后切片、Embedding、写库在 Worker 中执行，依赖 Redis
RAG_CELERY_BROKER_URL=redis://localhost:6379/0
RAG_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Langfuse 检索可观测：记录 trace/span，配合反馈 API 做效果分析；不用可保持 false
RAG_LANGFUSE_ENABLED=false
RAG_LANGFUSE_HOST=http://localhost:3000
RAG_LANGFUSE_PUBLIC_KEY=
RAG_LANGFUSE_SECRET_KEY=
